<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      Pre-release local feed: Antiphon isn't published to nuget.org yet (blocked on EULA review
      and a standards-completion decision — see README.md's release-posture note). Packages here
      are a straight copy of ../Antiphon's own `tools/pack-release.sh` output, so this repo builds
      standalone without a sibling checkout of the private Antiphon repo present. Remove this
      source once real packages are live on nuget.org and pin PackageReference versions normally.
    -->
    <add key="antiphon-local" value="local-feed" />
  </packageSources>
</configuration>
